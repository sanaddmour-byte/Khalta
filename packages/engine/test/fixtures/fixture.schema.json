{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "mode": {
      "type": "string",
      "const": "evaluate"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "ruleset_mode": {
      "type": "string",
      "enum": ["ACI", "JS", "BOTH"]
    },
    "request": {
      "type": "object",
      "properties": {
        "fc_mpa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "basis": {
          "type": "string",
          "enum": ["cylinder", "cube", "b_grade"]
        },
        "exposure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slump_mm": {
          "type": ["number", "null"]
        },
        "nmas_mm": {
          "type": ["number", "null"]
        },
        "pumpable": {
          "type": ["boolean", "null"]
        },
        "air_pct": {
          "type": ["number", "null"]
        },
        "s3_option": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["fc_mpa", "basis", "exposure"],
      "additionalProperties": false
    },
    "project_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "value": {},
          "kind": {
            "type": "string"
          },
          "units": {
            "type": "string"
          },
          "clause_ref": {
            "type": "string"
          }
        },
        "required": ["requirement", "value"],
        "additionalProperties": false
      }
    },
    "materials": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "cement",
              "scm",
              "fine_agg",
              "coarse_agg",
              "water",
              "admixture",
              "fiber",
              "pigment"
            ]
          },
          "passing_pct": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "price_jod_per_kg": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["id", "category"],
        "additionalProperties": {}
      }
    },
    "proportions_kg_per_m3": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "wcm": {
          "type": ["number", "null"]
        },
        "volume_m3": {
          "type": "number"
        },
        "cost_jod_per_m3": {
          "type": ["string", "null"]
        },
        "compliance": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["pass", "fail", "not_evaluated"]
          }
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "incomplete"]
        },
        "fcr_mpa": {
          "type": ["number", "null"]
        },
        "tolerance": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "number"
            },
            "wcm": {
              "type": "number"
            },
            "cost": {
              "type": "number"
            }
          },
          "required": ["volume", "wcm", "cost"],
          "additionalProperties": false
        }
      },
      "required": [
        "wcm",
        "volume_m3",
        "cost_jod_per_m3",
        "compliance",
        "verdict",
        "fcr_mpa",
        "tolerance"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "mode",
    "source",
    "synthetic",
    "ruleset_mode",
    "request",
    "materials",
    "proportions_kg_per_m3",
    "expected"
  ],
  "additionalProperties": false
}
