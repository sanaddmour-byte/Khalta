{
  "name": "khalta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise packages apps --config tools/boundaries/dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:rules": "turbo run test:rules",
    "e2e": "playwright test",
    "screens": "playwright test --config playwright.screens.config.ts",
    "db:migrate": "pnpm --filter @khalta/db migrate",
    "db:seed:demo": "pnpm --filter @khalta/api seed:demo",
    "fixtures:export": "node scripts/stub.mjs fixtures:export M2.2",
    "db:drift": "pnpm --filter @khalta/db drift",
    "features:check": "pnpm --filter @khalta/features-check check",
    "rules:sync": "pnpm --filter @khalta/api rules:sync",
    "rules:export-seed": "pnpm --filter @khalta/api rules:export-seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "catalog:",
    "@khalta/eslint-plugin": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "pg": "catalog:"
  }
}
